{
  "name": "startername",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --recursive --stream run dev",
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive --stream run test",
    "check-types": "pnpm --recursive --stream --no-bail run check-types",
    "prettify": "pnpm --recursive run prettify",
    "lint:eslint": "pnpm --recursive --stream run lint",
    "lint:oxlint": "oxlint",
    "lint": "pnpm run lint:eslint && pnpm run lint:oxlint",
    "check:duplicates": "jscpd apps configs scripts types",
    "prepare": "husky",
    "commit": "cz",
    "update:workspaces": "pnpm update --interactive --recursive"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@types/node": "catalog:",
    "commitizen": "4.3.1",
    "cz-git": "1.12.0",
    "eslint": "catalog:",
    "husky": "9.1.7",
    "jscpd": "4.3.0",
    "lint-staged": "16.2.7",
    "oxlint": "1.78.0",
    "prettier": "catalog:",
    "rimraf": "6.1.2",
    "tsx": "catalog:"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git",
      "czConfig": "./cz.config.cjs"
    }
  },
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": "26.5.0",
    "pnpm": ">=10.0.0"
  }
}
